surface("app")
root = Tabs([{title: "Last 7 days", child: week}, {title: "Last 30 days", child: month}, {title: "Cases", child: cases}, {title: "Disputes", child: disputes}])

week = Column([week_head, week_brief, week_kpis, week_watch, week_charts, week_tables, week_alerts, week_sales_note, week_sync_note])
week_head = Heading("Store sales", 1, $/data/week/range)
week_brief = Card(Column([Heading("This week", 3, "Written by the desk at each sync"), Text($/data/week/brief)]))
week_kpis = Row([week_net, week_orders, week_aov, week_refunds])
week_net = Card(Column([Heading("Net sales", 3, "vs. previous 7 days"), Metric($/data/week/kpis/net/label, $/data/week/kpis/net/value, $/data/week/kpis/net/trendValue, $/data/week/kpis/net/trend)]), 1)
week_orders = Card(Column([Heading("Orders", 3, "vs. previous 7 days"), Metric($/data/week/kpis/orders/label, $/data/week/kpis/orders/value, $/data/week/kpis/orders/trendValue, $/data/week/kpis/orders/trend)]), 1)
week_aov = Card(Column([Heading("Avg order value", 3, "vs. previous 7 days"), Metric($/data/week/kpis/aov/label, $/data/week/kpis/aov/value, $/data/week/kpis/aov/trendValue, $/data/week/kpis/aov/trend)]), 1)
week_refunds = Card(Column([Heading("Refunds", 3, $/data/week/refundsNote), Metric($/data/week/kpis/refunds/label, $/data/week/kpis/refunds/value, $/data/week/kpis/refunds/trendValue, $/data/week/kpis/refunds/trend), week_ask_why]), 1)
week_ask_why = Button(week_ask_why_label, "borderless", Event("ask_why", {metric: "refunds", draft: $/data/week/askRefunds}))
week_ask_why_label = Row([week_ask_why_icon, week_ask_why_text], "start", "center")
week_ask_why_icon = Icon("help")
week_ask_why_text = Text("Ask AI why", "caption")

week_watch = Row([week_needs, week_findings])
week_needs = Card(Column([Heading("Needs you", 3, $/data/summary/casesNote), List(_template($/data/needs, needRow))]), 1)
needRow = Row([needText, needButton], "spaceBetween", "center")
needText = Column([needTop, needDetail])
needTop = Row([needBadge, needTitle], "start", "center")
needBadge = Badge($label, $tone)
needTitle = Text($title)
needDetail = Text($detail, "caption")
needButton = Button(needButtonText, "default", Event("open_case", {id: $id, kind: $kind, ref: $ref}))
needButtonText = Text("Work this case")
week_findings = Card(Column([Heading("Recent findings", 3, $/data/summary/findingsNote), List(_template($/data/findings, findingRow))]), 1)
findingRow = Column([findingTop, findingConclusion, findingAction])
findingTop = Row([findingTitle, findingWhen], "spaceBetween", "center")
findingTitle = Text($title)
findingWhen = Text($when, "caption")
findingConclusion = Text($conclusion, "caption")
findingAction = Row([findingSource, findingDismiss], "spaceBetween", "center")
findingSource = Text($action, "caption")
findingDismiss = Button(findingDismissIcon, "borderless", Event("dismiss_finding", {id: $id}))
findingDismissIcon = Icon("close")

week_alerts = Card(Column([week_alerts_head, List(_template($/data/alerts, alertRow))]))
week_alerts_head = Row([Heading("Alerts", 3, $/data/summary/alertsNote), week_add_alert], "spaceBetween", "center")
week_add_alert = Button(week_add_alert_label, "borderless", Event("add_alert", {draft: "Add an alert: every week, if the refund rate changes by more than 1.5 pts or goes above 5%, analyze it automatically and post the conclusion to the board."}))
week_add_alert_label = Row([week_add_alert_icon, week_add_alert_text], "start", "center")
week_add_alert_icon = Icon("add")
week_add_alert_text = Text("Add with AI", "caption")
alertRow = Row([alertText, alertStatus, alertDelete], "spaceBetween", "center")
alertText = Column([alertName, alertRule, alertReading])
alertName = Text($name)
alertRule = Text($rule, "caption")
alertReading = Text($reading, "caption")
alertStatus = Badge($status, $tone)
alertDelete = Button(alertDeleteIcon, "borderless", Event("delete_alert", {id: $id}))
alertDeleteIcon = Icon("delete")
week_charts = Row([week_country, week_daily])
week_country = Card(Column([Heading("Sales by country", 3, "Share of sales, %"), PieChart(data=$/data/week/byCountry, donut=true)]), 1)
week_daily = Card(Column([Heading("Daily sales", 3, "Net of refunds, per day"), BarChart(data=$/data/week/daily, xKey="label", series=[{key: "value", label: "Net sales", color: "#10b981"}], valuePrefix="$")]), 1)
week_tables = Row([week_top, week_latest])
week_top = Card(Column([Heading("Top products", 3, "By sales this week"), DataTable([{key: "product", label: "Product"}, {key: "units", label: "Units", align: "end"}, {key: "sales", label: "Sales", align: "end"}], $/data/week/topProducts)]), 1)
week_latest = Card(Column([Heading("Latest orders", 3, "Newest first"), DataTable([{key: "id", label: "Order"}, {key: "customer", label: "Customer"}, {key: "country", label: "Country"}, {key: "items", label: "Items"}, {key: "total", label: "Total", align: "end"}, {key: "status", label: "Status", badge: {Paid: "success", Refunded: "warning"}}], $/data/week/latest)]), 1)

month = Column([month_head, month_kpis, month_charts, month_products, month_sales_note, month_sync_note])
month_head = Heading("Store sales", 1, $/data/month/range)
month_kpis = Row([month_net, month_orders, month_aov, month_refunds])
month_net = Card(Column([Heading("Net sales", 3, "After refunds"), Metric($/data/month/kpis/net/label, $/data/month/kpis/net/value, $/data/month/kpis/net/trendValue, $/data/month/kpis/net/trend)]), 1)
month_orders = Card(Column([Heading("Orders", 3, "Paid orders"), Metric($/data/month/kpis/orders/label, $/data/month/kpis/orders/value, $/data/month/kpis/orders/trendValue, $/data/month/kpis/orders/trend)]), 1)
month_aov = Card(Column([Heading("Avg order value", 3, "Per order"), Metric($/data/month/kpis/aov/label, $/data/month/kpis/aov/value, $/data/month/kpis/aov/trendValue, $/data/month/kpis/aov/trend)]), 1)
month_refunds = Card(Column([Heading("Refunds", 3, "Share of sales"), Metric($/data/month/kpis/refunds/label, $/data/month/kpis/refunds/value, $/data/month/kpis/refunds/trendValue, $/data/month/kpis/refunds/trend)]), 1)
month_charts = Row([month_country, month_mix])
month_country = Card(Column([Heading("Sales by country", 3, "Share of sales, %"), PieChart(data=$/data/month/byCountry, donut=true)]), 1)
month_mix = Card(Column([Heading("Units by product and country", 3, "Top 10 products"), BarChart(data=$/data/month/productCountry, xKey="label", series=[{key: "US", label: "United States", color: "#3b82f6"}, {key: "CA", label: "Canada", color: "#8b5cf6"}, {key: "GB", label: "United Kingdom", color: "#ec4899"}, {key: "AU", label: "Australia", color: "#f59e0b"}, {key: "DE", label: "Germany", color: "#10b981"}, {key: "other", label: "Other", color: "#94a3b8"}], stacked=true)]), 2)
month_products = Card(Column([Heading("All products", 3, "Units by country, most sold first"), DataTable([{key: "product", label: "Product"}, {key: "units", label: "Units", align: "end"}, {key: "sales", label: "Sales", align: "end"}, {key: "US", label: "US", align: "end"}, {key: "CA", label: "CA", align: "end"}, {key: "GB", label: "GB", align: "end"}, {key: "AU", label: "AU", align: "end"}, {key: "DE", label: "DE", align: "end"}, {key: "other", label: "Other", align: "end"}], $/data/month/products)]))

week_sales_note = Text($/data/salesNote, "caption")
week_sync_note = Text($/data/sync/note, "caption")
month_sales_note = Text($/data/salesNote, "caption")
month_sync_note = Text($/data/sync/note, "caption")

cases = Column([casesHead, caseList])
casesHead = Heading("Cases", 2, $/data/summary/casesNote)
caseList = List(_template($/data/cases, caseCard))
caseCard = Card(caseBody)
caseBody = Column([caseTop, caseDetail, caseButton])
caseTop = Row([caseTitle, caseBadge], "spaceBetween", "center")
caseTitle = Heading($title, 3)
caseBadge = Badge($label, $tone)
caseDetail = Text($detail)
caseButton = Button(caseButtonText, "primary", Event("open_case", {id: $id, kind: $kind, ref: $ref}))
caseButtonText = Text("Work this case")

disputes = Column([disputesHead, disputeTable])
disputesHead = Heading("Disputes", 2, $/data/summary/disputesNote)
disputeTable = DataTable([{key: "id", label: "Dispute"}, {key: "reason", label: "Reason"}, {key: "amount", label: "Amount", align: "end"}, {key: "status", label: "Status", badge: {OPEN: "danger", WAITING_FOR_SELLER_RESPONSE: "danger", UNDER_REVIEW: "warning", WAITING_FOR_BUYER_RESPONSE: "info", RESOLVED: "success"}}, {key: "respondBy", label: "Respond by"}], $/data/disputes)
