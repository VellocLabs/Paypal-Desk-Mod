surface("app")
root = Tabs([{title: "Overview", child: week}, {title: "Trends", child: trends}, {title: "Actions", child: todo, badge: $/data/summary/todoCount}], open=$/data/summary/openTab)

week = Column([week_head, week_kpis, week_charts, week_tables, week_sales_note, week_sync_note])
week_head = Heading(subtitle=$/data/week/range, action=Event("compose", {text: $/data/week/ask/all}), actionLabel="Ask AI to analyze all changes")
week_kpis = Row([week_net, week_orders, week_aov, week_refunds])
week_net = Card(Column([Heading("Net sales", 3, "vs. previous 7 days"), Metric($/data/week/kpis/net/label, $/data/week/kpis/net/value, $/data/week/kpis/net/trendValue, $/data/week/kpis/net/trend, action=Event("compose", {text: $/data/week/ask/net}), actionLabel="Ask AI to analyze")]), 1)
week_orders = Card(Column([Heading("Orders", 3, "vs. previous 7 days"), Metric($/data/week/kpis/orders/label, $/data/week/kpis/orders/value, $/data/week/kpis/orders/trendValue, $/data/week/kpis/orders/trend, action=Event("compose", {text: $/data/week/ask/orders}), actionLabel="Ask AI to analyze")]), 1)
week_aov = Card(Column([Heading("Avg order value", 3, "vs. previous 7 days"), Metric($/data/week/kpis/aov/label, $/data/week/kpis/aov/value, $/data/week/kpis/aov/trendValue, $/data/week/kpis/aov/trend, action=Event("compose", {text: $/data/week/ask/aov}), actionLabel="Ask AI to analyze")]), 1)
week_refunds = Card(Column([Heading("Refunds", 3, $/data/week/refundsNote), Metric($/data/week/kpis/refunds/label, $/data/week/kpis/refunds/value, $/data/week/kpis/refunds/trendValue, $/data/week/kpis/refunds/trend, better="down", action=Event("compose", {text: $/data/week/ask/refunds}), actionLabel="Ask AI to analyze")]), 1)

week_charts = Row([week_country, week_daily])
week_country = Card(Column([Heading("Sales by country", 3, "Share of sales"), PieChart(data=$/data/week/byCountry, donut=true, valueSuffix="%")]), 1)
week_daily = Card(Column([Heading("Daily sales", 3, "Net of refunds, per day"), BarChart(data=$/data/week/daily, xKey="label", series=[{key: "value", label: "Net sales", color: "#10b981"}], valuePrefix="$")]), 1)
week_tables = Row([week_top, week_latest])
week_top = Card(Column([Heading("Top products", 3, "By sales this week"), DataTable([{key: "product", label: "Product"}, {key: "units", label: "Units", align: "end"}, {key: "sales", label: "Sales", align: "end"}], $/data/week/topProducts)]), 1)
week_latest = Card(Column([Heading("Latest orders", 3, "Newest first"), DataTable([{key: "id", label: "Order"}, {key: "customer", label: "Customer"}, {key: "country", label: "Country"}, {key: "items", label: "Items"}, {key: "total", label: "Total", align: "end"}, {key: "status", label: "Status", badge: {Paid: "success", Refunded: "warning"}}], $/data/week/latest)]), 1)

trends = Column([trends_head, trends_net, trends_volume, trends_risk, trends_movers, trends_sales_note, trends_sync_note])
trends_head = Heading(subtitle=$/data/trends/range, action=Event("compose", {text: $/data/trends/ask}), actionLabel="Ask AI to analyze the trends")
trends_net = Card(Column([Heading("Net sales", 3, "Per day, with the 7-day average"), LineChart(data=$/data/trends/daily, xKey="label", series=[{key: "net", label: "Per day", color: "#6ee7b7"}, {key: "netAvg", label: "7-day average", color: "#059669"}], curved=true, height=260, valuePrefix="$")]))
trends_volume = Row([trends_orders, trends_aov])
trends_orders = Card(Column([Heading("Orders", 3, "Per day, with the 7-day average"), LineChart(data=$/data/trends/daily, xKey="label", series=[{key: "orders", label: "Per day", color: "#93c5fd"}, {key: "ordersAvg", label: "7-day average", color: "#2563eb"}], curved=true)]), 1)
trends_aov = Card(Column([Heading("Avg order value", 3, "Over the last 7 days"), LineChart(data=$/data/trends/daily, xKey="label", series=[{key: "aov", label: "Avg order value", color: "#8b5cf6"}], curved=true, valuePrefix="$")]), 1)
trends_risk = Row([trends_refunds, trends_country])
trends_refunds = Card(Column([Heading("Refund rate", 3, "Share of sales refunded, over the last 7 days"), LineChart(data=$/data/trends/daily, xKey="label", series=[{key: "refundRate", label: "Refund rate", color: "#f59e0b"}], curved=true, valueSuffix="%")]), 1)
trends_country = Card(Column([Heading("Sales by country", 3, "Per week"), LineChart(data=$/data/trends/countryWeekly, xKey="label", series=[{key: "US", label: "United States", color: "#3b82f6"}, {key: "CA", label: "Canada", color: "#8b5cf6"}, {key: "GB", label: "United Kingdom", color: "#ec4899"}, {key: "AU", label: "Australia", color: "#f59e0b"}, {key: "DE", label: "Germany", color: "#10b981"}, {key: "other", label: "Other", color: "#94a3b8"}], valuePrefix="$")]), 1)
trends_movers = Card(Column([Heading("Product movers", 3, "Units, last 7 days against the 7 before"), DataTable([{key: "product", label: "Product"}, {key: "units", label: "Last 7 days", align: "end"}, {key: "before", label: "7 days before", align: "end"}, {key: "change", label: "Change", align: "end"}], $/data/trends/movers)]))

week_sales_note = Text($/data/salesNote, "caption")
week_sync_note = Text($/data/sync/note, "caption")
trends_sales_note = Text($/data/salesNote, "caption")
trends_sync_note = Text($/data/sync/note, "caption")

todo = Column([todoHead, disputeHead, disputeList, otherHead, alertTodoList, todoList, doneSectionView, alertsHead, ruleAlertList])
todoHead = Heading(subtitle=$/data/summary/casesNote)
disputeHead = Heading($/data/groups/disputesTitle, 2, $/data/groups/disputesNote)
otherHead = Heading($/data/groups/otherTitle, 2)
disputeList = Column(_template($/data/disputeCases, disputeCard))
disputeCard = Card(disputeRow)
disputeRow = Row([disputeMain, disputeButtons], "spaceBetween", "center")
disputeMain = Column([disputeTop, disputeVerdictLine], "start", "stretch", 1)
disputeTop = Row([disputeIcon, disputeTitle, disputeVerdictBadge], "start", "start")
disputeIcon = Text($icon)
disputeTitle = Heading($title, 3)
disputeVerdictBadge = Badge($verdictLabel, $verdictTone)
disputeVerdictLine = Heading(subtitle=$verdictLine)
disputeButtons = Row([disputeDetails, disputeAsk, disputeDone], "end", "center")
disputeDetails = Modal(disputeDetailsButton, disputeView)
disputeDetailsButton = Button(disputeDetailsText, "default", Event("open_details", {id: $ref}))
disputeDetailsText = Text("Details")
disputeAsk = Button(disputeAskText, "default", Event("compose", {quote: $discussQuote}))
disputeAskText = Text("Ask AI")
disputeDone = Button(disputeDoneText, "default", Event("mark_done", {id: $id}))
disputeDoneText = Text("Mark done")
disputeView = Column([disputeViewHead, disputeViewMeta, disputeViewCall, disputeViewWhy, disputeViewSteps, disputeViewReply, disputeViewChecked], "start", "stretch")
disputeViewHead = Heading($detailsTitle, 2, $detailsSubtitle)
disputeViewMeta = Row([disputeViewBadge, disputeViewConfidence, disputeViewNote], "start", "center")
disputeViewBadge = Badge($detailsLabel, $detailsTone)
disputeViewConfidence = Text($detailsConfidence, "caption")
disputeViewNote = Text($detailsNote, "caption")
disputeViewCall = Card(Column([Heading("The AI's call", 3), Text($detailsHeadline, "body")]))
disputeViewWhy = Card(Column([Heading("Why", 3, "The facts the call rests on"), disputeWhyLines], "start", "stretch"))
disputeWhyLines = Column([disputeWhy1, disputeWhy2, disputeWhy3, disputeWhy4], "start", "stretch")
disputeWhy1 = Text($detailsWhy1, "caption")
disputeWhy2 = Text($detailsWhy2, "caption")
disputeWhy3 = Text($detailsWhy3, "caption")
disputeWhy4 = Text($detailsWhy4, "caption")
disputeViewSteps = Card(Column([Heading("Next steps", 3, "In PayPal's Resolution Center"), disputeStepLines], "start", "stretch"))
disputeStepLines = Column([disputeStep1, disputeStep2, disputeStep3, disputeStep4], "start", "stretch")
disputeStep1 = Text($detailsStep1, "caption")
disputeStep2 = Text($detailsStep2, "caption")
disputeStep3 = Text($detailsStep3, "caption")
disputeStep4 = Text($detailsStep4, "caption")
disputeViewReply = Card(Column([Heading("Reply draft", 3, "Paste it into the Resolution Center"), Text($detailsReply, "body")]))
disputeViewChecked = Card(Column([Heading("What the desk checked", 3, "From your PayPal account"), disputeCheckLines], "start", "stretch"))
disputeCheckLines = Column([disputeCheck1, disputeCheck2, disputeCheck3, disputeCheck4, disputeCheck5, disputeCheck6], "start", "stretch")
disputeCheck1 = Text($detailsCheck1, "caption")
disputeCheck2 = Text($detailsCheck2, "caption")
disputeCheck3 = Text($detailsCheck3, "caption")
disputeCheck4 = Text($detailsCheck4, "caption")
disputeCheck5 = Text($detailsCheck5, "caption")
disputeCheck6 = Text($detailsCheck6, "caption")

alertTodoList = Column(_template($/data/alertCases, alertTodoCard))
alertTodoCard = Card(alertTodoRow)
alertTodoRow = Row([alertTodoMain, alertTodoButtons], "spaceBetween", "center")
alertTodoMain = Column([alertTodoTop, alertTodoDetail], "start", "stretch", 1)
alertTodoTop = Row([alertTodoIcon, alertTodoTitle, alertTodoAct], "start", "start")
alertTodoIcon = Text($icon)
alertTodoTitle = Heading($title, 3, $source)
alertTodoAct = Badge($actLabel, $actTone)
alertTodoDetail = Text($detail, "caption")
alertTodoButtons = Row([alertTodoDetails, alertTodoAsk, alertTodoDone], "end", "center")
alertTodoDetails = Modal(alertTodoDetailsButton, alertTodoView)
alertTodoDetailsButton = Button(alertTodoDetailsText, "default", Event("open_details", {id: $ref}))
alertTodoDetailsText = Text("Details")
alertTodoAsk = Button(alertTodoAskText, "default", Event("compose", {text: $ask}))
alertTodoAskText = Text("Ask AI")
alertTodoDone = Button(alertTodoDoneText, "default", Event("mark_done", {id: $id}))
alertTodoDoneText = Text("Mark done")

alertTodoView = Column([alertViewHead, alertViewMeta, alertViewCall, alertViewChart, alertViewDo], "start", "stretch")
alertViewHead = Heading($detailsTitle, 2, $detailsSubtitle)
alertViewMeta = Row([alertViewBadge, alertViewNote], "start", "center")
alertViewBadge = Badge($label, $tone)
alertViewNote = Text($source, "caption")
alertViewCall = Card(Column([Heading("The AI's call", 3), Text($detailsHeadline, "body"), Text($detailsConclusion, "body")], "start", "stretch"))
alertViewChart = Card(Column([Heading($detailsChartTitle, 3, $detailsChartNote), LineChart(data=$detailsSeries, xKey="label", series=[{key: "value", label: "Week by week", color: "#10b981"}], curved=true, height=220)]))
alertViewDo = Card(Column([Heading("What to do", 3, "From the AI's analysis"), Text($detailsAction, "body")]))

todoList = Column(_template($/data/otherCases, todoCard))
todoCard = Card(todoRow)
todoRow = Row([todoMain, todoButtons], "spaceBetween", "center")
todoMain = Column([todoTop, todoDetail], "start", "stretch", 1)
todoTop = Row([todoIcon, todoTitle, todoBadge], "start", "start")
todoIcon = Text($icon)
todoTitle = Heading($title, 3, $source)
todoBadge = Badge($label, $tone)
todoDetail = Text($detail, "caption")
todoButtons = Row([todoAsk, todoDone], "end", "center")
todoAsk = Button(todoAskText, "default", Event("compose", {text: $ask}))
todoAskText = Text("Ask AI")
todoDone = Button(todoDoneText, "default", Event("mark_done", {id: $id}))
todoDoneText = Text("Mark done")

doneSectionView = Column([doneHeadList, doneList], "start", "stretch")
doneHeadList = Column(_template($/data/doneHeadRows, doneHeadRow))
doneHeadRow = Row([doneToggle], "start", "center")
doneToggle = Button(doneTag, "borderless", Event("toggle_done"))
doneTag = Text($label)
doneList = Column(_template($/data/doneShown, doneCard))
doneCard = Card(doneRow)
doneRow = Row([doneMain, doneMenu], "spaceBetween", "center")
doneMain = Column([doneTop, doneDetail], "start", "stretch", 1)
doneTop = Row([doneIcon, doneTitle, doneBadge], "start", "start")
doneIcon = Text($icon)
doneTitle = Heading($title, 3, $doneNote)
doneBadge = Badge($label, $tone)
doneDetail = Text($detail, "caption")
doneMenu = Menu("⋯", [doneUndo, doneDelete])
doneUndo = Button(doneUndoText, "borderless", Event("undo_done", {id: $id}))
doneUndoText = Text("Undo")
doneDelete = Button(doneDeleteText, "borderless", Event("delete_todo", {id: $id}))
doneDeleteText = Text("Delete")

alertsHead = Heading("Alert rules", 2, $/data/summary/alertsNote)

ruleAlertList = Grid(_template($/data/ruleCards, ruleCard), minWidth=320, after=ruleAdd)
ruleAdd = AddCard("Add alert with AI", Event("compose", {text: "Add an alert: if any product's refund rate over the last 7 days goes above 10%, or the store's net sales for the week drop below $20,000, tell me and analyze why."}))
ruleCard = Card(ruleBody)
ruleBody = Column([ruleHeading, ruleBar])
ruleHeading = Row([ruleIcon, ruleName], "start", "center")
ruleIcon = Text($icon)
ruleName = Heading($name, 3, $condition)
ruleBar = HoverBar([ruleEdit, ruleDelete])
ruleEdit = Button(ruleEditLabel, "borderless", Event("compose", {text: $editAsk}))
ruleEditLabel = Row([ruleEditIcon, ruleEditText], "start", "center")
ruleEditIcon = Icon("edit")
ruleEditText = Text("Edit")
ruleDelete = Button(ruleDeleteLabel, "borderless", Event("compose", {text: $deleteAsk}))
ruleDeleteLabel = Row([ruleDeleteIcon, ruleDeleteText], "start", "center")
ruleDeleteIcon = Icon("delete")
ruleDeleteText = Text("Delete")
