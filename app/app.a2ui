surface("app")
root = Tabs([{title: "Overview", child: overview}, {title: "Cases", child: cases}, {title: "Invoices", child: invoices}, {title: "Disputes", child: disputes}, {title: "Plans", child: plans}])

overview = Column([overviewHead, metrics, trendCard, syncNote])
overviewHead = Heading("PayPal Desk", 1, $/data/summary/period)
metrics = Row([salesMetric, refundsMetric, overdueMetric, disputesMetric])
salesMetric = Metric("Sales", $/data/summary/sales, $/data/summary/salesDelta, $/data/summary/salesTrend, "Completed payments in the window", 1)
refundsMetric = Metric("Refunds", $/data/summary/refunds, _, _, $/data/summary/refundRate, 1)
overdueMetric = Metric("Overdue invoices", $/data/summary/overdueCount, _, _, $/data/summary/overdueAmount, 1)
disputesMetric = Metric("Open disputes", $/data/summary/disputeCount, _, _, $/data/summary/disputeDue, 1)
trendCard = Card(trend)
trend = LineChart("Daily sales and refunds", $/data/series/daily, "day", [{key: "sales", label: "Sales"}, {key: "refunds", label: "Refunds"}], true, 240, "$")
syncNote = Text($/data/sync/note, "caption")

cases = Column([casesHead, caseList])
casesHead = Heading("Cases", 2, $/data/summary/casesNote)
caseList = List(_template($/data/cases, caseCard))
caseCard = Card(caseBody)
caseBody = Column([caseTop, caseDetail, caseButton])
caseTop = Row([caseTitle, caseBadge], "spaceBetween", "center")
caseTitle = Heading($title, 3)
caseBadge = Badge($label, $tone)
caseDetail = Text($detail)
caseButton = Button(caseButtonText, "primary", Event("open_case", {id: $id, kind: $kind, ref: $ref}))
caseButtonText = Text("Work this case")

invoices = Column([invoicesHead, invoiceTable])
invoicesHead = Heading("Invoices", 2, $/data/summary/invoicesNote)
invoiceTable = DataTable([{key: "number", label: "Invoice"}, {key: "recipient", label: "Recipient"}, {key: "amount", label: "Amount", align: "end"}, {key: "status", label: "Status", badge: {PAID: "success", MARKED_AS_PAID: "success", SENT: "info", UNPAID: "warning", PARTIALLY_PAID: "warning", OVERDUE: "danger", DRAFT: "neutral", CANCELLED: "neutral"}}, {key: "due", label: "Due"}], $/data/invoices)

disputes = Column([disputesHead, disputeTable])
disputesHead = Heading("Disputes", 2, $/data/summary/disputesNote)
disputeTable = DataTable([{key: "id", label: "Dispute"}, {key: "reason", label: "Reason"}, {key: "amount", label: "Amount", align: "end"}, {key: "status", label: "Status", badge: {OPEN: "danger", WAITING_FOR_SELLER_RESPONSE: "danger", UNDER_REVIEW: "warning", WAITING_FOR_BUYER_RESPONSE: "info", RESOLVED: "success"}}, {key: "respondBy", label: "Respond by"}], $/data/disputes)

plans = Column([plansHead, planTable])
plansHead = Heading("Subscription plans", 2, $/data/summary/plansNote)
planTable = DataTable([{key: "name", label: "Plan"}, {key: "id", label: "Id"}, {key: "status", label: "Status", badge: {ACTIVE: "success", INACTIVE: "neutral", CREATED: "info"}}, {key: "created", label: "Created"}], $/data/plans)
